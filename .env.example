# Secrets only. `./dojo setup` creates `.env` from this file (or copy it by hand) and
# fills in real values; `.env` is git-ignored, never commit it. Everything that is not a
# secret (URLs, ports, student count, terminal flavor ...) is in dojo.toml.
#
# Any variable may also be set here and wins over dojo.toml: a place for account names
# and addresses you would rather keep out of the repo.
#
# A `[name]` header starts a profile's secrets: lines under it apply only with
# `--env name` (see dojo.toml). Lines above the first header apply to every run.
#
#   [home]
#   TTYD_PASSWORD=student
#   FACILITATOR_PASSWORD=dojo-admin

# The class sign-in's password: shown on a slide. Its username is dojo.toml's [general] class_username.
TTYD_PASSWORD=change-me

# Facilitator (Linux shell with passwordful sudo, and /admin): keep this one private.
# Required: the terminal refuses to start with a guessable default.
FACILITATOR_PASSWORD=change-me

# Machine to machine; nobody types these. `openssl rand -hex 32` for a real class.
# CONTROL_TOKEN proves a request to web-terminal's control API came from the allocator;
# GATEWAY_TOKEN proves a request to the allocator came through Caddy.
CONTROL_TOKEN=change-me
GATEWAY_TOKEN=change-me

# Forgejo's machine admin. The facilitator reaches Forgejo through single sign-on.
FORGEJO_ADMIN_PASSWORD=change-me

# Each student's own Forgejo password is derived from this seed.
STUDENT_PASSWORD_SEED=change-me

# Demo bot accounts (./dojo <workshop> --test); uncomment to change the default.
# BOT_PASSWORD=
