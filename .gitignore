/.env
/dojo.local.toml
# Leftovers of the old engine/.env layout (the CLI renames them *.migrated).
engine/.env
engine/.last-overlay
engine/.build-state/
engine/.generated/
# The dojo CLI's unpacked, hash-checked dependencies (engine/dojo/boot.py).
engine/.cache/
# Project-local caches for one-time pulls that `./dojo stop` would
# otherwise wipe (modules/ctf-range/ctf-host's inner-dockerd image store
# lives under .cache/ctf-docker/; see its Dockerfile + entrypoint for the
# content-sha stamp that invalidates it on a rebuild).
.cache/
.infra/**/*.auto.tfvars
.infra/**/.terraform/
.infra/**/*.tfstate*
__pycache__/
*.pyc
CLAUDE.md
# Generated by the dojo CLI's lab-copy step (engine/dojo/) from content/lab/*.md -- never
# hand-edited, regenerated on every run.
workshops/*/content/slides/lab/
engine/.env.*
# Build-time copies of modules/_shared/ files (SHARED= in module.env; engine/dojo/build.py).
modules/*/**/_shared/
