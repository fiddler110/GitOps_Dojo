# macOS with rootful Podman (podman machine, SELinux in the VM). Without these
# two, no runner-pool runner or vault app can start: `unshare: mount /proc
# failed`. `./run.sh setup --default --force` rewrites engine/.env from
# .env.example and drops them, which is why they live here. Details:
# modules/runner-pool/README.md. Not needed on Linux or with Docker.
RUNNER_POOL_SECURITY_OPT_1=unmask=/proc/*
RUNNER_POOL_SECURITY_OPT_2=label=type:container_engine_t
