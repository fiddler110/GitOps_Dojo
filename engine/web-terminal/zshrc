# Shared .zshrc for every account in the web-terminal container (students,
# demo bots and the facilitator), used by both the ttyd web-terminal and
# code-server's integrated terminal. entrypoint.sh symlinks each account's
# ~/.zshrc to this file on every container start, so edits here take effect
# for everyone on the next restart without touching entrypoint.sh. The only
# per-role difference is the ulimit block below.
#
# Edit this file directly to add aliases, tool init, etc. for everyone;
# personal aliases go in ~/.zshrc_aliases (loaded at the end).

autoload -Uz compinit
compinit

setopt auto_cd
setopt correct
setopt interactive_comments

# Word and line movement. Without these, Ctrl/Alt+arrows print a stray "5D"
# or "3C": zsh has no default binding for the xterm-style codes that
# browsers send and tmux passes through (xterm-keys is on).
bindkey '^[[1;5D' backward-word   # Ctrl+Left
bindkey '^[[1;5C' forward-word    # Ctrl+Right
bindkey '^[[1;3D' backward-word   # Alt+Left
bindkey '^[[1;3C' forward-word    # Alt+Right
bindkey '^[[H' beginning-of-line  # Home
bindkey '^[[F' end-of-line        # End
bindkey '^[[1~' beginning-of-line # Home (tmux)
bindkey '^[[4~' end-of-line       # End (tmux)
bindkey '^[[3~' delete-char       # Delete
bindkey '^[[3;5~' kill-word       # Ctrl+Delete
bindkey '^H' backward-kill-word   # Ctrl+Backspace (xterm.js sends DEL, not ^H, for plain Backspace)

# Per-account ceiling so one account (fork bomb, runaway `dd`, etc.) can't
# take down the shared web-terminal container for every other student.
# Hard and soft set equal and to the same value at every login so a
# student can't raise it mid-session; see docker-compose.yml's web-terminal
# pids_limit/mem_limit for the container-wide backstop behind this.
# Approximate on purpose: shells don't agree on ulimit -f's block size, so
# treat this as "generously large", not an exact byte count.
# The facilitator (entrypoint.sh puts them in the dojo-facilitator group)
# gets twice the headroom, since they may work in several places at once.
if (( ${${(s: :)$(id -Gn)}[(Ie)dojo-facilitator]} )); then
  ulimit -Hu 256 -Su 256
  ulimit -Hf 2097152 -Sf 2097152
else
  ulimit -Hu 128 -Su 128
  ulimit -Hf 1048576 -Sf 1048576
fi

eval "$(zoxide init zsh)"

# Modifying Terminal Prompt to Start on NewLine
PS1=$'\n%n@%m %~\n$ '


# Colourised `ls` (by file type/extension) in both this shell (ttyd) and
# code-server's integrated terminal, since both run against this same file.
eval "$(dircolors -b)"

# General Aliases
alias ls="ls -GF --color=auto"
alias ll="ls -lGFa --color=auto"
alias la="ls -aGF --color=auto"
alias l="ls -GF --color=auto"
alias lla="ls -alGF --color=auto"
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# RipGrep Alias for Case-Insensitive by Default
alias rg="rg -i"

# Bat Alias for Colours
alias bat="bat --color=always --paging=auto"
alias batf="bat --language=terraform"

alias aliases="bat ~/.zshrc_aliases | rg alias"

# ── Search ────────────────────────────────────────────────────────────────────
# fk <keyword>  — find keyword in files under the current directory
unalias fk 2>/dev/null
fk() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: fk <keyword> [extra rg/grep options]"
    return 1
  fi
  if command -v rg &>/dev/null; then
    rg --color=always --heading --line-number "$@" .
  else
    grep -rn --color=always "$@" .
  fi
}
alias fk='nocorrect fk'

# ZSH Sort by Type
# Define a function that grabs the file extension
by_ext() {
  local ext="${1:e}"
  # If no extension, treat it as empty space so it groups together
  REPLY="${ext:- }"
}
# Create an alias that uses the function to sort
alias lse="ls -G *(oe:by_ext:)"

# ── Your own aliases ──────────────────────────────────────────────────────────
# ~/.zshrc is read-only (a symlink to this shared file), so personal aliases
# and functions go in ~/.zshrc_aliases instead, which you own. It's loaded
# last, so it can override anything above; `aliases` lists what's in it.
# Tools may add to it too (e.g. dns-as-code's `dnsctl.py setup` adds `dnsc`).
# After editing it, run `source ~/.zshrc_aliases` or open a new terminal.
if [[ ! -e ~/.zshrc_aliases ]]; then
  print -r -- '# Your own aliases and functions. Loaded by every new shell.
# Example:  alias gs="git status"' > ~/.zshrc_aliases 2>/dev/null
fi
[[ -r ~/.zshrc_aliases ]] && source ~/.zshrc_aliases
