{
  "version": 1,
  "cards": [
    {
      "id": "achievements",
      "label": "Leaderboard",
      "desc": "Your score, the class board and your achievements.",
      "href": "/achievements/",
      "icon": "rocket"
    }
  ],
  "admin_tabs": [
    {
      "id": "achievements",
      "label": "Achievements",
      "src": "/achievements-admin/"
    }
  ],
  "widgets": [
    {
      "id": "achievements",
      "src": "/achievements/widget",
      "size": "large"
    }
  ],
  "scripts": [
    {
      "id": "toasts",
      "src": "/achievements/toast.js"
    }
  ],
  "routes": [
    {
      "id": "achievements",
      "path": "/achievements",
      "upstream": "achievements:8080",
      "gate": "identity",
      "strip_prefix": true
    },
    {
      "id": "achievements-admin",
      "path": "/achievements-admin",
      "upstream": "achievements:8080",
      "gate": "facilitator"
    }
  ],
  "resets": [
    {
      "id": "achievements-progress",
      "label": "Achievements: challenge progress",
      "upstream": "achievements:8080",
      "path": "/_dojo/reset/progress/{user}"
    },
    {
      "id": "achievements-score",
      "label": "Also clear their achievements and score",
      "upstream": "achievements:8080",
      "path": "/_dojo/reset/score/{user}",
      "optional": true
    }
  ],
  "status_checks": [
    {
      "label": "Achievements",
      "url": "http://achievements:8080/healthz"
    }
  ]
}
