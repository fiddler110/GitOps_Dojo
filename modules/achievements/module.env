# achievements module defaults; engine/.env (ACHIEVEMENTS_*) overrides them. Paths are
# relative to engine/. See engine/.env.example for the point values and switches.
ACHIEVEMENTS_MEM_LIMIT=128m
# Signs the events the dns-gate module posts to the service (its /api/adapter). Derived from this
# install's GATEWAY_TOKEN (engine/.env, sourced first), never in the repo; blank without one.
ACHIEVEMENTS_ADAPTER_SECRET="$(printf 'achievements/adapter:%s' "${GATEWAY_TOKEN:-}" | sha256sum | cut -c1-40)"
