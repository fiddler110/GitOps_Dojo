# achievements module defaults; .env (ACHIEVEMENTS_*) overrides them. Paths are
# relative to engine/. See .env.example for the point values and switches.
ACHIEVEMENTS_MEM_LIMIT=128m
# Signs the events the dns-gate module posts to the service (its /api/adapter). Derived from this
# install's GATEWAY_TOKEN (.env, sourced first), never in the repo; blank without one.
ACHIEVEMENTS_ADAPTER_SECRET="$(printf 'achievements/adapter:%s' "${GATEWAY_TOKEN:-}" | sha256sum | cut -c1-40)"

# modules/_shared/ files this module's services import, copied into <folder>/_shared/ by ./dojo.
SHARED="service/dojo_http.py"
