# ctf-range module defaults; a workshop.env overrides them (README.md). Paths
# are relative to engine/.

# The student handle a target seeds its synthetic data from, and the flag the
# target hands up when breached. In a real run the engine renders these per
# slot — the flag value from HMAC-SHA256(STUDENT_PASSWORD_SEED,
# "ctf:<challenge>:<user>") (§5), the seed never reaching the target — and the
# per-slot fan-out (spike CTF-S1) sets them per target-NN. These defaults only
# make the single dev instance in compose.yml build and run standalone.
CTF_STUDENT=student07
CTF_FLAG=flag{customer-portal-dev0000000000}

# Wall of shame (§8.12) render toggle, on|off. Default OFF here; a pack that
# lists the /ctf-wall widget (workshops/ctf-defend) sets it on in its own
# workshop.env. It gates ONLY whether ctf-controller's /ctf-wall page draws the
# wall: the dump events, status light, MTTP and incident summary (achievements)
# work either way. CTF_WALL_AGE_OFF_SECONDS: how long a DISCONNECTED (contained)
# entry stays up before it ages off the page (achievements itself drops it at 30 min).
CTF_WALL_OF_SHAME=off
CTF_WALL_AGE_OFF_SECONDS=300

# Per-target container caps. customer-portal is one lightweight Flask+SQLite
# process; CTF-5 runs five always-live targets per student, so keep this small
# (§8 / capacity spikes S2, S15).
CTF_TARGET_MEM_LIMIT=128m
CTF_TARGET_PIDS_LIMIT=256

# --- range control plane (CTF-D21 / spike S14) -------------------------------
# The boxed ctf-host dind and its one client ctf-controller. Resource bounds
# for the dind box are generous (it runs every slot inside it); tune per
# STUDENT_COUNT on the target machine. cold-start at 40 students is unmeasured
# (S14), so these are starting points, not proven figures.
CTF_HOST_MEM_LIMIT=2g
CTF_HOST_PIDS_LIMIT=4096
CTF_CONTROLLER_MEM_LIMIT=128m

# --- per-pack ctf-host image scoping (CTF-D26) -------------------------------
# ctf-host/Dockerfile now has five final build stages: `ctf-host` (default,
# the full catalog — what every var below defaults to, so any OTHER pack
# that lists ctf-range and doesn't override these vars is unaffected), `ctf-host-ctf1` (CTF-1 only), `ctf-host-ctf2` (CTF-2 only), `ctf-host-ctf3` and `ctf-host-ctf4`.
# A real per-session pack overrides all three together in its own
# workshop.env: CTF_HOST_BUILD_TARGET to the matching stage name,
# CTF_HOST_IMAGE to a distinct tag (so building one pack never clobbers
# another pack's cached image — see worktree-shared-image-tags.md), and
# CTF_HOST_EXPECTED_IMAGES to the subset of tags that stage actually bakes in
# (entrypoint.sh's import_* functions each skip gracefully when their rootfs
# isn't present, so this only needs to match what IS there).
CTF_HOST_BUILD_TARGET=ctf-host
CTF_HOST_IMAGE=gitopsdojo/ctf-host:local
CTF_HOST_EXPECTED_IMAGES="ctf-customer-portal:base gitopsdojo/ctf-customer-portal-base:pinned ctf-sqli-login:base ctf-idor-pcap:base ctf-weak-auth-portal:base ctf-cert-trust-bypass:base ctf-ping-tool:base ctf-ssrf-fetcher:base ctf-api-mass-assignment:base ctf-api-bfla:base ctf-leaky-config:base ctf-git-secrets:base ctf-policy-bypass:base ctf-dns-resolver-cve:base"

# Range-wide flag seed (§5). Empty here = a clearly-marked dev flag per slot;
# a real run sets STUDENT_PASSWORD_SEED in .env. The seed lives only in
# ctf-controller; targets receive the rendered value, never the seed.
# STUDENT_PASSWORD_SEED=

# Token the allocator / defend pipeline present to ctf-controller's control
# API. Empty = the control API fails closed (no mutating calls accepted).
# CTF_CONTROL_TOKEN=

# --- in-lab registry + ctf-builder (spike S6) --------------------------------
# The registry ctf-host's dockerd pulls from (a redeploy) and ctf-builder
# pushes to (a merge-triggered rebuild), and the prefix a pulled/pushed image
# name must carry. Both services are internal-only (compose.yml); this is not
# a secret, just the approved name.
CTF_REGISTRY=registry:5000
CTF_REGISTRY_MEM_LIMIT=256m
CTF_BUILDER_MEM_LIMIT=256m

# The repo name ctf-builder clones per student (http://git-server/<user>/<this>.git).
# Fixed to target 14's own repo; a workshop pack overrides it only if it names
# the seed repo differently.
CTF_BUILDER_REPO_NAME=customer-portal

# Token defend-main.yml's merge job presents to ctf-builder's /build endpoint.
# Deliberately separate from CTF_CONTROL_TOKEN (narrower blast radius per
# service — see ctf-builder/builder.py's Config). Empty = fails closed.
# CTF_BUILD_TOKEN=

# Where Forgejo's git HTTP lives from ctf-builder's side (runner_net, not
# ctf_ops — see compose.yml's ctf-builder comment). Default matches
# modules/runner-pool's git-server wiring.
CTF_GIT_SERVER=git-server:3000

# --- flag submission (§5) ----------------------------------------------------
# ctf-flags: a small service on workshop_lab the terminal's `dojo-flag` CLI
# talks to directly. ACHIEVEMENTS_ADAPTER_URL/SECRET are the same class-wide
# values every adapter module uses (modules/achievements/module.env); unset
# means a verified flag is never credited, not that submission fails.
SHARED="ctf-flags/adapter_client.py ctf-controller/dojo_http.py attacker-bot/adapter_client.py"
CTF_FLAGS_MEM_LIMIT=64m

# --- Lab Info library in the browser (plan §9, CTF-D16/P2b) -----------------
# ctf-lab-info: stock Caddy serving terminal/content/lab-info read-only.
# Tiny and static, so the default is small.
CTF_LAB_INFO_MEM_LIMIT=32m

# --- per-uid target reachability (CTF-S2/S3; see compose.yml's ctf-host and
# the terminal firewall hook) -------------------------------------------------
# web-terminal joins ctf_net (compose.yml) only to reach ctf-host's published
# slot ports - it is NOT on ctf_ops, so it never reaches ctf-controller, the
# registry, or ctf-host's docker socket, only the one address ctf-host
# presents on ctf_net. The per-uid OUTPUT rule in
# modules/ctf-range/terminal/start.d/50-ctf-range.sh restricts each student's
# uid to the one port ctf-controller assigned their slot (HOST_PORT_BASE +
# index, same roster order as ctf-controller/controller.py's Config). Must
# match CTF_HOST_PORT_BASE below if that default is ever changed on either
# side - see the hook's header comment.
CTF_HOST_PORT_BASE=15000

# --- student-controlled attack ladder (plan §4 "Student-controlled targets,
# one live per slot", decision CTF-D20; CTF-1 to CTF-4 only, CTF-5 is exempt
# and keeps its always-on model above) -------------------------------------
# CTF_ATTACK_TARGETS: 'id=image:tag,id=image:tag,...'. Empty by default — the
# AttackManager (ctf-controller/controller.py) is fully generic over this
# catalog, so a workshop pack wires its real targets by setting this, never
# by changing code; leaving it empty here keeps every OTHER workshop's stack
# (cert-autorenewal, dns-as-code, ...) from getting an attack-range card it
# never asked for. 8 of the plan's §7.3 CTF-1/CTF-2 target images are now
# built and baked into ctf-host (ctf-host/Dockerfile + entrypoint.sh):
# sqli-login, idor-pcap, weak-auth-portal, cert-trust-bypass, ping-tool,
# ssrf-fetcher, api-mass-assignment, api-bfla, each importable as
# ctf-<name>:base. See any ctf-* pack's workshop.env (e.g. workshops/ctf-access)
# for the shape of a real CTF_ATTACK_TARGETS wire-up.
# (Earlier live-verified during CTF-D20's build with a temporary override
# pointing one id at the customer-portal base image — see
# docs/CTF-WORKSHOP-PLAN.md's checkpoint.)
CTF_ATTACK_TARGETS=
# A different port base than CTF_HOST_PORT_BASE above, so an attack slot and
# a CTF-5 always-on slot for the same student never collide on ctf-host.
# terminal/start.d/50-ctf-range.sh's per-uid firewall rule must agree with
# this value, same pairing as CTF_HOST_PORT_BASE.
CTF_ATTACK_PORT_BASE=16000
# How many consecutive host ports each student's attack slot reserves: the
# real app, plus a fixed block of decoy ports a target's own image may or
# may not bind (plan §7.3's nmap primer — controller.py's Config.attack_ports,
# DECOY_SSH_CONTAINER_PORT/DECOY_FTP_CONTAINER_PORT). terminal/start.d/
# 50-ctf-range.sh's per-uid firewall rule opens the whole block as one range
# and must agree with this value, same pairing as CTF_ATTACK_PORT_BASE.
CTF_ATTACK_PORT_BLOCK=3
# Auto-stop a live target after this many idle seconds (plan §4 "Limits",
# ~20 min) — time-based, not real traffic; see AttackManager.sweep_idle's
# docstring for why.
CTF_ATTACK_IDLE_SECONDS=1200
# At most this many starts/resets run at once (plan §4 "Start queue", ~10,
# tuned in S14).
CTF_ATTACK_MAX_CONCURRENT=10

# --- attacker-bot swarm + SOC feed (plan §8.2-8.11) --------------------------
# ONE container for the whole room (not a fleet): one thread per student,
# hitting that student's own CTF-5 target-NN over ctf_net's published ports,
# the same address the student's own terminal reaches it at. Posts straight to
# achievements (ACHIEVEMENTS_ADAPTER_URL/SECRET above) over workshop_lab - same
# trust tier as ctf-flags.
#
# Does nothing at all - no recon, no probes, no traffic of any kind - until the
# facilitator presses "Start Attack Swarm" on the SOC Alerts admin tab
# (achievements' POST /achievements-admin/api/soc/start). The lab can build and
# sit idle while students are walked through the briefing; the room's dwell
# clock begins the moment that button is pressed, not when the stack comes up.
# attacker-bot polls achievements (POST /api/soc/control, signed the same way
# as every event it posts) every few seconds until that happens, then uses the
# EXACT started_at achievements hands back, so the two processes' countdowns
# can never drift apart. No adapter secret configured (achievements not wired,
# a standalone/dev run) = starts immediately instead, since there's no
# facilitator button to wait for.
#
# Three phases on one shared room-wide clock from there (CTF-D18): green/recon
# (CTF_SOC_DWELL_SECONDS), yellow/escalating (CTF_SOC_RAMP_SECONDS, ramping
# toward attacker-bot/personas.py's fixed RAMP_FLOOR), then red/detonated -
# every attempt from there on is the real payload. The achievements-side
# countdown (store.py's soc_timer()) computes the identical phase from the
# same two durations, duplicated there with a comment back to here.
CTF_SOC_DWELL_SECONDS=480
CTF_SOC_RAMP_SECONDS=600
# Test clock: CTF_TIME_SCALE multiplies every duration on the attack timeline above (dwell, ramp, per-
# attempt delays, the ramp floor, detonation jitter, hint-probe gaps) in attacker-bot AND in the countdown
# achievements reports, so the admin timer matches the bot. Deliberately NOT set here: `./dojo <workshop>
# --test` sets it to 0.1 (dwell 48s, ramp 60s) and a real run leaves it at 1. Override with
# CTF_TIME_SCALE=1 ./dojo ctf-defend --test (real clock with demo bots) or any other factor.
# The wall of shame's 90s LIVE window and age-off are display timings, not part of the timeline: unscaled.
# Where students with no usable public client address (a LAN, WSL) sit on the cyber map - a city
# (Toronto, Vancouver, Calgary, ...) or "lat,lon,Label" - see modules/achievements/service/geo.py.
CTF_HOME_REGION=Toronto
CTF_ATTACKER_BOT_MEM_LIMIT=64m

# The facilitator's "Inject"/"Hint probe" controls (plan §8.5, SOC Alerts admin tab) reuse the
# same /api/soc/control poll above - no extra port, no extra env. See bot.py's command_loop.
