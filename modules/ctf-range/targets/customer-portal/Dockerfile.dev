# customer-portal, DEV PATH ONLY (CTF-D27). Built on the OUTER host engine by
# modules/ctf-range/compose.yml's standalone `customer-portal` service, which
# has a real network at build time but no local copy of
# gitopsdojo/ctf-customer-portal-base:pinned (that tag only ever exists
# inside ctf-host's INNER dockerd, imported offline at container start --
# see Dockerfile's own header and ctf-host/Dockerfile's `portal-deps` stage).
# This file installs Flask the normal way instead of FROMing that tag. Never
# used by ctf-builder, never shipped to a student's repo (sync-sample-repos.sh
# copies `Dockerfile`, not this file) -- so it is fine for it to need a
# network, unlike `Dockerfile`, which must not (see that file's CTF-D27 note).
FROM docker.io/library/python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY app.py seed.py entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh

RUN useradd --uid 10014 --no-create-home --home-dir /app --shell /usr/sbin/nologin portal \
    && mkdir -p /data \
    && chown portal:portal /data
VOLUME /data

ENV CTF_DB_PATH=/data/portal.db \
    PORT=5000 \
    PYTHONUNBUFFERED=1
EXPOSE 5000

USER portal
WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
