# dns-gate module defaults; a workshop.env overrides them (README.md).

# modules/_shared/ files this module's services import, copied into <folder>/_shared/ by ./dojo.
SHARED="gate/adapter_client.py"

# Each account owns <user>.<parent> and every name under it, for each parent
# here (a whole zone of its own, or its own names inside a shared zone).
DNS_GATE_USER_PARENTS=dojo.test
# Zones every account writes into, but only records under its own names
# (cert-autorenewal: certs.dojo.test). Empty: none.
DNS_GATE_SHARED_ZONES=
# Zones only CI changes: a Forgejo Actions ID token from a push to main of
# DNS_GATE_CI_REPO (org/repo). Empty: none.
DNS_GATE_CI_ZONES=
DNS_GATE_CI_REPO=
# Reads only; not a secret (CI's preview job uses it).
DNS_GATE_READ_KEY=workshop-not-a-secret
# Records a student reset puts back after removing the student's names (space-separated name/TYPE/content,
# {user} in the name), when the workshop seeds some per account at start (cert-autorenewal's dns-seed).
DNS_GATE_RESET_RECORDS=

# Per-identity request tripwire, not a budget: a token bucket per account
# (x5 for CI and the read key, which the whole class shares). Far above a
# dnscontrol push or a --test run; a refusal is a 429 and an audit line.
# 0 = off.
DNS_API_RATE_BURST=200
DNS_API_RATE_PER_SEC=50
