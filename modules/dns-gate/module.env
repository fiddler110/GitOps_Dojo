# dns-gate module defaults; a workshop.env overrides them (README.md).
#
# Each account owns <user>.<parent> and every name under it, for each parent
# here (a whole zone of its own, or its own names inside a shared zone).
DNS_GATE_USER_PARENTS=dojo.test
# Zones every account writes into, but only records under its own names
# (cert-autorenewal: certs.dojo.test). Empty: none.
DNS_GATE_SHARED_ZONES=
# Zones only CI changes: a Forgejo Actions ID token from a push to main of
# DNS_GATE_CI_REPO (org/repo). Empty: none.
DNS_GATE_CI_ZONES=
DNS_GATE_CI_REPO=
# Reads only; not a secret (CI's preview job uses it).
DNS_GATE_READ_KEY=workshop-not-a-secret
