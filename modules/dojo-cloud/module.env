# dojo-cloud module defaults; a workshop.env overrides them.
#
# Per-student request tripwire on CloudAPI (ARM calls), not a budget: a token
# bucket per account, far above a tofu apply or a --test run. A refusal is a
# 429 with Retry-After and a log line naming the account. 0 = off.
CLOUD_API_RATE_BURST=200
CLOUD_API_RATE_PER_SEC=20
# Read-only credential for the achievements service (may only GET one account's own overview, Policy blade and activity log, see
# portal_api._check_read). Derived from this install's GATEWAY_TOKEN (.env), never in the repo.
CLOUD_CHECK_TOKEN="$(printf 'cloud/check:%s' "${GATEWAY_TOKEN:-}" | sha256sum | cut -c1-40)"
ACHIEVEMENTS_CLOUD_API_URL=http://cloud-api:8080

# modules/_shared/ files this module's services import, copied into <folder>/_shared/ by ./dojo.
SHARED="cloud-api/dojo_http.py cloud-api/adapter_client.py"
