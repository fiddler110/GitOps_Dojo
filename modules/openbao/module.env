# openbao module defaults; a workshop.env overrides them. Paths are relative
# to engine/.
OPENBAO_MEM_LIMIT=512m

# A tripwire, not a budget: requests per second one student's namespace
# (students/<name>/) may make before OpenBao answers 429. Far above what a
# lab or a --test bot does; it stops a runaway loop starving the class.
# 0 = no quota.
OPENBAO_NAMESPACE_RATE=200

# The host part of PUBLIC_BASE_URL (already set from engine/.env and any
# --env file when this is read): OpenBao resolves it to the SSO shim next to
# it (compose.yml).
OPENBAO_PUBLIC_HOST="${PUBLIC_BASE_URL#*://}"
OPENBAO_PUBLIC_HOST="${OPENBAO_PUBLIC_HOST%%[:/]*}"

# The achievements service's read-only OpenBao token: its id is derived from this install's GATEWAY_TOKEN
# (engine/.env), never in the repo, and the workshop's setup hook mints a token with that id.
BAO_CHECK_TOKEN="$(printf 'openbao/check:%s' "${GATEWAY_TOKEN:-}" | sha256sum | cut -c1-40)"
BAO_CHECK_URL=http://openbao:8200

# modules/_shared/ files this module's services import, copied into <folder>/_shared/ by ./run.sh.
SHARED="audit/dojo_http.py"
