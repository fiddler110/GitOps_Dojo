# openbao module defaults; a workshop.env overrides them. Paths are relative
# to engine/.
OPENBAO_MEM_LIMIT=512m

# The host part of PUBLIC_BASE_URL (already set from engine/.env and any
# --env file when this is read): OpenBao resolves it to the SSO shim next to
# it (compose.yml).
OPENBAO_PUBLIC_HOST="${PUBLIC_BASE_URL#*://}"
OPENBAO_PUBLIC_HOST="${OPENBAO_PUBLIC_HOST%%[:/]*}"
