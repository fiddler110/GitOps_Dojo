# runner-pool module defaults; a workshop.env overrides them. Paths are
# relative to engine/.

# Warm pool: idle runners kept ready (the Runners panel's - / + move it in
# Auto). Max runners: empty means ceil(STUDENT_COUNT / 3), at least 2, at
# most 12 (VAULT-FUNDAMENTALS-PLAN.md §6.3). This is only the starting value:
# the facilitator can change it on the panel (up to 24, or this if higher).
RUNNER_MIN_IDLE=2
RUNNER_MAX=
# An idle runner above the warm pool goes after this many seconds; a job
# running longer than RUNNER_JOB_TIMEOUT turns its light red (and the runner
# gives up on it).
RUNNER_IDLE_TIMEOUT=120
RUNNER_JOB_TIMEOUT=900

# The whole pool, and each runner's prlimit caps (per process: RUNNER_AS is
# address space in bytes, empty for none; Go programs reserve a lot of it).
RUNNER_POOL_MEM_LIMIT=2g
RUNNER_POOL_PIDS=2048
RUNNER_NPROC=256
RUNNER_NOFILE=1024
RUNNER_AS=

# The host part of PUBLIC_BASE_URL: the pool resolves it to the shim next to
# it (compose.yml).
RUNNER_PUBLIC_HOST="${PUBLIC_BASE_URL#*://}"
RUNNER_PUBLIC_HOST="${RUNNER_PUBLIC_HOST%%[:/]*}"
