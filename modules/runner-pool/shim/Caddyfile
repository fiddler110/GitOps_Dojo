# ID-token shim for the runner-pool module (VAULT-FUNDAMENTALS-PLAN.md S24,
# S28). Runs inside the pool's network namespace and answers for
# PUBLIC_BASE_URL there, so a job's calls to Forgejo's public URLs (the
# Actions ID token, `git clone $GITHUB_SERVER_URL/...`) reach git-server
# directly: the public name loops back to the pool itself on a laptop and
# has no route out of runner_net on a VM. Browsers never see it.
{
	admin off
	auto_https disable_redirects
}

{$PUBLIC_BASE_URL} {
	# A real HTTPS name: serve it with Caddy's own CA, which the pool's
	# supervisor adds to the jobs' trust store. No effect for http://.
	tls internal

	# Forgejo 16 builds the ID-token URL from a sub-path ROOT_URL as
	# /git//gitapi/actions/...: map it back to /api/actions/... Caddy has
	# already cleaned the double slash, hence /git/+git.
	@idtoken path_regexp idtoken ^/git/+git(api/actions/.*)$
	rewrite @idtoken /{re.idtoken.1}

	handle_path /git/* {
		reverse_proxy git-server:3000
	}
	handle /api/actions/* {
		reverse_proxy git-server:3000
	}
	handle {
		respond "not served by the runner-pool shim" 404
	}
}
