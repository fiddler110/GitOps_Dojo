# Workshop identity for {{name}}, read by ./dojo (made by `./dojo new-workshop`).
# Paths are relative to engine/ (the compose base file's directory, see
# workshops/README.md for why).
WORKSHOP_NAME="{{title}}"
WORKSHOP_DESCRIPTION="{{description}}"
WORKSHOP_ORDER={{order}}   # position in the learning path (0 = showcase); ./dojo list sorts by it
WORKSHOP_DURATION="{{duration}}"   # how long a session takes, shown by ./dojo list; keep it in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/{{name}}/content
FORGEJO_ORG={{org}}
FORGEJO_REPO={{repo}}     # content/sample-repo/ is seeded into Forgejo as {{org}}/{{repo}}

# Modules this workshop uses (./dojo modules lists them).
MODULES="{{modules}}"

# A Compose overlay for extra services, only if no module provides them:
# COMPOSE_OVERLAY=../workshops/{{name}}/compose/docker-compose.override.yml
COMPOSE_OVERLAY=
