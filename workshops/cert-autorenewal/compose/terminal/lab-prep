#!/usr/bin/env bash
# lab-prep <lab>: bring this student's workspace to the state lab <lab> starts
# from, so someone joining late (or coming back another day) can resume there
# instead of redoing every earlier lab. Each step checks before it acts, so
# running it twice, or after doing some labs by hand, is safe. It only moves
# forward: it never deletes a certificate or undoes an edit.
#
# What each lab needs (keep in step with content/lab/*.md when a lab changes):
#   2     the step CLI trusts step-ca (Lab 1)
#   3-5   your site on demo-app serving HTTPS with a certbot certificate
#         (Lab 2). Lab 3's acme.sh answers on that vhost, Lab 4 renews that
#         certificate, Lab 5 compares against it.
# Certificates here live 5-10 minutes, so an expired one is issued again.
set -euo pipefail

CA_URL=https://step-ca:9443
ROOT_CA=/opt/step-ca-root/root_ca.crt
ACME_DIR=$CA_URL/acme/acme/directory
LAST_LAB=5

me=$(whoami)
host=$me.certs.dojo.test
web=/srv/webroot/$me
conf=$web/conf.d/$me.conf
templates=$HOME/lab/sample-repo

say()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
done_() { printf '    already done: %s\n' "$*"; }
run()  { printf '    $ %s\n' "$*"; "$@"; }
die()  { printf '\n\033[1;31mlab-prep: %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: lab-prep <lab>       (1-$LAST_LAB)

Sets up everything the earlier labs would have left behind, so you can start
lab <lab> right away. Safe to run more than once.

  lab-prep 2    trust step-ca (Lab 1)
  lab-prep 4    ...and your HTTPS site with a certbot certificate (Lab 2)
EOF
}

# -- Lab 1: trust the CA ------------------------------------------------------
trust_ca() {
  say "Lab 1: trust step-ca"
  if grep -qs "$CA_URL" "$HOME/.step/config/defaults.json"; then
    done_ "step is bootstrapped for $CA_URL"
  else
    run step ca bootstrap --ca-url "$CA_URL" --fingerprint "$(step certificate fingerprint "$ROOT_CA")"
  fi
  run step ca health --ca-url "$CA_URL"
}

# -- Lab 2: issue and install with certbot ------------------------------------
site_http() {
  say "Lab 2 steps 1-2: your port-80 site on demo-app"
  [ -d "$web/conf.d" ] && [ -w "$web/conf.d" ] || die "$web is missing. Ask the facilitator."
  [ -f "$web/html/index.html" ] && done_ "index.html" ||
    { echo "<h1>${host}</h1>" > "$web/html/index.html"; echo "    wrote $web/html/index.html"; }
  if [ -f "$conf" ]; then
    done_ "$conf exists"
  else
    sed "s/studentNN/${me}/g" "$templates/vhost-http.conf.template" > "$conf"
    echo "    wrote $conf"
  fi
  demo_ip=$(dig @dns-server "$host" +short | head -1)
  [ -n "$demo_ip" ] || die "$host doesn't resolve on dns-server. Ask the facilitator."
  # demo-app's watcher reloads nginx a moment after the file changes.
  for _ in $(seq 20); do
    curl -fs --resolve "${host}:80:${demo_ip}" "http://${host}/" >/dev/null && return 0
    sleep 1
  done
  die "demo-app doesn't serve http://${host}/ yet. Check $conf, then run lab-prep again."
}

site_https() {
  say "Lab 2 steps 3-4: a certbot certificate, installed"
  if [ -f "$web/certs/fullchain.pem" ] && openssl x509 -checkend 30 -noout -in "$web/certs/fullchain.pem" >/dev/null; then
    done_ "the installed certificate is still valid"
  else
    mkdir -p ~/certbot/{config,work,logs}
    REQUESTS_CA_BUNDLE=$ROOT_CA run certbot certonly \
      --config-dir ~/certbot/config --work-dir ~/certbot/work --logs-dir ~/certbot/logs \
      --webroot -w "$web/html" -d "$host" --server "$ACME_DIR" \
      --agree-tos --non-interactive --email "${me}@example.com"
    run cp ~/certbot/config/live/"$host"/fullchain.pem "$web/certs/fullchain.pem"
    run cp ~/certbot/config/live/"$host"/privkey.pem "$web/certs/privkey.pem"
  fi
  if grep -q 'listen 443' "$conf"; then
    done_ "the TLS server block is in $conf"
  else
    sed "s/studentNN/${me}/g" "$templates/vhost-tls.conf.template" >> "$conf"
    echo "    appended the TLS server block to $conf"
  fi
  for _ in $(seq 20); do
    curl -fs --resolve "${host}:443:${demo_ip}" --cacert "$ROOT_CA" "https://${host}/" >/dev/null && {
      echo "    https://${host}/ answers with a certificate curl trusts"
      return 0
    }
    sleep 1
  done
  die "https://${host}/ doesn't answer yet. Try Lab 2 step 5 by hand."
}

# -----------------------------------------------------------------------------
case "${1:-}" in
  -h|--help|"") usage; exit 0 ;;
esac
lab=$1
[[ "$lab" =~ ^[0-9]+$ ]] && [ "$lab" -ge 1 ] && [ "$lab" -le "$LAST_LAB" ] || { usage >&2; exit 2; }

if [ "$lab" -eq 1 ]; then
  echo "Lab 1 is the start: nothing to set up. Open lab1.md and go."
  exit 0
fi

trust_ca
if [ "$lab" -ge 3 ]; then
  site_http
  site_https
fi

say "Ready for Lab $lab"
echo "    open lab$lab.md"
