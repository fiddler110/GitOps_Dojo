# Port-80 vhost for studentNN.certs.dojo.test — serves the ACME http-01
# challenge file certbot/acme.sh drop into ./html/.well-known/acme-challenge/,
# and your actual site content once you're done. No TLS yet — that's the
# other template, added once a certificate exists to point at.
#
# Copy this to /srv/webroot/studentNN/conf.d/studentNN.conf (with studentNN
# replaced by your own account name in every place it appears, including
# server_name and the root paths) — see Lab 2.

server {
    listen 80;
    server_name studentNN.certs.dojo.test;

    root /srv/webroot/studentNN/html;

    location /.well-known/acme-challenge/ {
        root /srv/webroot/studentNN/html;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
