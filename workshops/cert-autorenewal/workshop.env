# Workshop identity for cert-autorenewal, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="Certificate Autorenewal Lab"
WORKSHOP_CONTENT_DIR=../workshops/cert-autorenewal/content
FORGEJO_ORG=cert-team
FORGEJO_REPO=cert-autorenewal
DEMO_APP_ZONE=certs.dojo.test

# Adds a shared step-ca (ACME CA), a shared demo-app (nginx, one vhost per
# student), a PowerDNS instance (resolves each student's hostname to
# demo-app, and answers the optional dns-01 capstone), and a terminal image
# with step/certbot/acme.sh preinstalled. See workshops/cert-autorenewal/compose/.
COMPOSE_OVERLAY=../workshops/cert-autorenewal/compose/docker-compose.override.yml

# Reusable parts from the top-level modules/ folder (see modules/<name>/README.md).
# dns-ui: the read-only DNS Zones page (/dns): each student's A record and the
# _acme-challenge TXT records appearing and disappearing during dns-01.
# dns-gate: dns-api, the only way to the PowerDNS API. The class shares the
# zone certs.dojo.test, and each account's own key ($DNS_API_KEY) changes
# only names under <user>.certs.dojo.test (its dns-01 TXT record, its A).
MODULES="dns-ui dns-gate"
DNS_GATE_USER_PARENTS=certs.dojo.test
DNS_GATE_SHARED_ZONES=certs.dojo.test

# The key PowerDNS itself accepts: derived from this install's GATEWAY_TOKEN
# (engine/.env, sourced first), so it is never in the repo and students never
# see it. dns-seed, dns-api and the dns-ui module get it.
POWERDNS_API_KEY="$(printf 'cert-autorenewal/powerdns:%s' "${GATEWAY_TOKEN:?}" | sha256sum | cut -c1-40)"
