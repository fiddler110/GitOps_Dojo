# Workshop identity for cloud-policy-as-code, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory).
WORKSHOP_NAME="Cloud-Policy-as-Code"
WORKSHOP_DESCRIPTION="Write the rules that keep a cloud safe as code: Dojo Cloud Policy definitions, assignments and sets, Rego checks, and a CI pipeline."
WORKSHOP_ORDER=6   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_CONTENT_DIR=../workshops/cloud-policy-as-code/content
FORGEJO_ORG=platform-team
FORGEJO_REPO=cloud-policy-as-code
# Lab 0 has each student fork platform-team/cloud-policy-as-code and work in the fork.
FORGEJO_FORK_WORKFLOW=1

# Dojo Cloud (and its Policy engine) from the dojo-cloud module; CI on
# runner-pool's single-use runners (labs 11-12). compose/terminal/ adds opa and
# conftest to the tofu terminal image.
MODULES="dojo-cloud runner-pool sensei"
# Gives CI jobs tofu, opa, conftest, the provider mirror and a route to Dojo Cloud.
COMPOSE_OVERLAY=../workshops/cloud-policy-as-code/compose/docker-compose.override.yml
