# Workshop identity for ctf-access (CTF-1, docs/CTF-WORKSHOP-PLAN.md), read by
# ./run.sh (made by `./run.sh new-workshop`, then wired to the real attack
# ladder). Paths are relative to engine/ (the compose base file's directory,
# see workshops/README.md for why).
#
# CTF-1 "Access and identity": the plan's ladder rows 0, 2, 1, 3 (sqli-login,
# weak-auth-portal, idor-pcap, cert-trust-bypass) -- the low tier, no module
# deps beyond ctf-range itself. Students only ever attack these four, never
# patch them (that's CTF-5); there is no seed repo for the targets themselves.
WORKSHOP_NAME="CTF-1: Access and Identity"
WORKSHOP_DESCRIPTION="Capture-the-flag warm-up: getting in when auth or access checks are weak"
WORKSHOP_ORDER=100   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_DURATION="~150 min (~130 + ~20 min Linux/nmap primer)"   # plan section 8
WORKSHOP_CONTENT_DIR=../workshops/ctf-access/content
FORGEJO_ORG=training
FORGEJO_REPO=ctf-access     # content/sample-repo/ (briefing notes only; no lab writes here) seeded as training/ctf-access

# Modules this workshop uses (./run.sh modules lists them).
MODULES="ctf-range"

# Small on purpose for a facilitator's own live validation run; bump for a
# real class (STUDENT_COUNT drives the slot fan-out, CTF-S1).
STUDENT_COUNT=2

# --- ctf-range control-plane tokens (module.env: empty = fails closed) -----
# Dev-only values. A real class run sets these to something generated, not
# committed; CLAUDE.md: no extra hardening needed for an ephemeral lab, but
# don't commit a value you'd mind a student reading.
CTF_CONTROL_TOKEN=dev-ctf-control-token-ctf-access

# --- CTF-D26 per-pack ctf-host image scoping ---------------------------
# Build only CTF-1's own 4 target rootfses into ctf-host, not the full
# 14-target catalog (module.env's default). See ctf-host/Dockerfile's
# `ctf-host-ctf1` stage and CTF-SPIKES.md's CTF-D26.
CTF_HOST_BUILD_TARGET=ctf-host-ctf1
CTF_HOST_IMAGE=gitopsdojo/ctf-host:ctf1
CTF_HOST_EXPECTED_IMAGES="ctf-sqli-login:base ctf-idor-pcap:base ctf-weak-auth-portal:base ctf-cert-trust-bypass:base"

# CTF-1's own 4-target slice of the ladder (plan section 8's row order:
# 0, 2, 1, 3). Ids match each target's own directory name under
# modules/ctf-range/targets/; module.env's own default stays empty for every
# other pack.
CTF_ATTACK_TARGETS=sqli-login=ctf-sqli-login:base,weak-auth-portal=ctf-weak-auth-portal:base,idor-pcap=ctf-idor-pcap:base,cert-trust-bypass=ctf-cert-trust-bypass:base

# A Compose overlay for extra services, only if no module provides them:
# COMPOSE_OVERLAY=../workshops/ctf-access/compose/docker-compose.override.yml
COMPOSE_OVERLAY=
