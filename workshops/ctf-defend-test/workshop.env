# Workshop identity for ctf-defend-test, read by ./run.sh (made by `./run.sh new-workshop`).
#
# *** THIS IS A FACILITATOR TEST HARNESS, NOT THE REAL CTF-5 SESSION PACK. ***
# It exists only to exercise the S6 defend loop (modules/ctf-range spike S6) end to end on a real
# stack: PR fix -> defend-pr.yml gate green -> merge -> defend-main.yml rebuild+redeploy -> the
# exploit against the live slot returns nothing. No attacker bots, SOC feed or wall of shame --
# those aren't built (docs/CTF-WORKSHOP-PLAN.md section 8, CTF-5). Do not point students at this
# pack; do not add rows for it to workshops/README.md's workshop table.
#
# Paths are relative to engine/ (the compose base file's directory, see
# workshops/README.md for why).
WORKSHOP_NAME="CTF Defend Test (harness)"
WORKSHOP_DESCRIPTION="Facilitator-only S6 proof harness for the defend-pipeline loop (target 14, customer-portal) -- NOT the CTF-5 session pack."
WORKSHOP_ORDER=99   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_DURATION="~15 min (facilitator-only test harness, not a real lesson)"   # how long a session takes, shown by ./run.sh list; keep it in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/ctf-defend-test/content
FORGEJO_ORG=ctf-defend-test
FORGEJO_REPO=customer-portal     # content/sample-repo/ (the MASTER seed copy only) is seeded here; see its README

# Small on purpose -- this is a test harness, not a class.
STUDENT_COUNT=2

# Modules this workshop uses (./run.sh modules lists them).
MODULES="ctf-range runner-pool"

# --- ctf-range control-plane tokens (module.env: empty = fails closed) -----
# Test-only values (not real secrets, this pack is never exposed to students
# for real use) -- /etc/dojo/start.d/90-ctf-defend-test.sh copies them onto
# every per-student customer-portal repo as Forgejo Actions secrets, matching
# what defend-main.yml reads (CLAUDE.md: no extra hardening for an ephemeral
# lab).
CTF_BUILD_TOKEN=test-ctf-build-token-ctf-defend-test-harness
CTF_CONTROL_TOKEN=test-ctf-control-token-ctf-defend-test-harness

# The real CTF-1/CTF-2 attack-ladder catalog (plan §7.3), to exercise
# CTF-D20's queue/toggle mechanics (AttackManager, ctf-controller/
# controller.py) against real target content on a real stack: every image is
# now baked into ctf-host (ctf-host/Dockerfile + entrypoint.sh). Ids match
# each target's own directory name under modules/ctf-range/targets/.
# module.env's own default stays empty for every other pack.
CTF_ATTACK_TARGETS=sqli-login=ctf-sqli-login:base,idor-pcap=ctf-idor-pcap:base,weak-auth-portal=ctf-weak-auth-portal:base,cert-trust-bypass=ctf-cert-trust-bypass:base,ping-tool=ctf-ping-tool:base,ssrf-fetcher=ctf-ssrf-fetcher:base,api-mass-assignment=ctf-api-mass-assignment:base,api-bfla=ctf-api-bfla:base,leaky-config=ctf-leaky-config:base,git-secrets=ctf-git-secrets:base

# A Compose overlay for extra services, only if no module provides them:
COMPOSE_OVERLAY=../workshops/ctf-defend-test/compose/docker-compose.override.yml
