# Workshop identity for ctf-defend, read by ./dojo (made by `./dojo new-workshop`).
# Paths are relative to engine/ (the compose base file's directory, see
# workshops/README.md for why).
WORKSHOP_NAME="CTF-5: Defend"
WORKSHOP_DESCRIPTION="Patch it with git: a live incident on your own app, defended with a PR, a CI gate and a redeploy."
WORKSHOP_ORDER=104   # position in the learning path (0 = showcase); ./dojo list sorts by it -- CTF-5, after ctf-trust-chain's 103
WORKSHOP_DURATION="~2 h"   # how long a session takes, shown by ./dojo list; keep it in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/ctf-defend/content
FORGEJO_ORG=ctf-defend
FORGEJO_REPO=customer-portal     # content/sample-repo/ is seeded into Forgejo as ctf-defend/customer-portal

# Modules this workshop uses (./dojo modules lists them).
MODULES="ctf-range runner-pool"

# This pack's own tokens for the ctf-range control plane (module.env: empty = fails closed).
# Derived from this install's GATEWAY_TOKEN (.env, sourced first), same pattern as
# ACHIEVEMENTS_ADAPTER_SECRET -- never a literal secret in the repo.
CTF_BUILD_TOKEN="$(printf 'ctf-range/build:%s' "${GATEWAY_TOKEN:-}" | sha256sum | cut -c1-40)"
CTF_CONTROL_TOKEN="$(printf 'ctf-range/control:%s' "${GATEWAY_TOKEN:-}" | sha256sum | cut -c1-40)"

# CTF-5 is the "always-on, one app-code target" defend session (plan §4, §7.3 row 14,
# decision CTF-D20/D25) -- it does NOT use the student-controlled attack ladder (CTF-1..4's
# CTF_ATTACK_TARGETS), so that stays at module.env's empty default; leave it unset here.

# Wall of shame (plan 8.12): project the live breach feed (widget + /ctf-wall route in this
# pack's extensions.json). on|off; off hides the wall only -- events, status light, MTTP and
# the incident summary keep working. Default on for this pack.
CTF_WALL_OF_SHAME=on

# Extra services (per-student repo provisioning for the defend pipeline -- see
# compose/terminal/start.d/90-ctf-defend.sh):
COMPOSE_OVERLAY=../workshops/ctf-defend/compose/docker-compose.override.yml

# --- Bonus second flaws + scoring (plan 8.7 / 8.10, decisions CTF-D17 / CTF-D19) -----------------
# CTF_BONUS_FLAWS=on|off: whether each defend target also ships a second, ungated "bonus" flaw. Default
# on for this pack; set it in .env (or the shell) to override. Off means: the student repo is seeded
# clean (90-ctf-defend.sh skips content/bonus/), the bots' probes skip the bonus area, there is no
# bonus CI check, and the c1 bonus challenge is hidden (no bonus points). Today only target 14 has
# one (targets 8-11 are not part of this pack yet).
CTF_BONUS_FLAWS="${CTF_BONUS_FLAWS:-on}"
case "$CTF_BONUS_FLAWS" in
  off|OFF|0|false|no)
    CTF_BONUS_FLAWS=off
    CTF_ACH_C1_FILE=../workshops/ctf-defend/achievements/variants/c1.off.json ;;
  *) CTF_BONUS_FLAWS=on ;;
esac
# --- SIEM request log on the SOC page (CTF_SIEM_DETAIL = full | paths | off) --------------------------
# What a student's own "Request log" shows of each logged request (the facilitator always sees all of
# it). full: method, path, status and the detection rule until THEIR target is breached, then the whole
# record (payload, response size, rows returned, agent). paths: method, path, status and rule only,
# never the payload or size. off: the old plain alerts, no request lines. Enforced server-side by
# achievements. Set it in .env or the shell to override; this file is the only place with a default
# (module.env does not set it, so the ${VAR:-x} form works here).
CTF_SIEM_DETAIL="${CTF_SIEM_DETAIL:-full}"
case "$CTF_SIEM_DETAIL" in full|paths|off) ;; *) CTF_SIEM_DETAIL=full ;; esac
# Points per status unit (green = 2 units, yellow = 1, red = 0, +1 per bonus fixed): the achievements
# default points for milestones (d-patched, d-unbreached) and challenges (c1) ARE this factor. At the
# default 5 that is 10/5/0 and +5 per bonus. First-blood and class-clear bonuses are off so the
# arithmetic stays exact.
CTF_SCORE_FACTOR="${CTF_SCORE_FACTOR:-5}"
ACHIEVEMENTS_MILESTONE_POINTS="$CTF_SCORE_FACTOR"
ACHIEVEMENTS_CHALLENGE_POINTS="$CTF_SCORE_FACTOR"
ACHIEVEMENTS_FIRST_BLOOD=0
ACHIEVEMENTS_CLASS_CLEAR=0
