# Workshop identity for ctf-secrets-config (CTF-3, docs/CTF-WORKSHOP-PLAN.md), read by
# ./dojo (made by `./dojo new-workshop`, then wired to the real attack
# ladder). Paths are relative to engine/ (the compose base file's directory,
# see workshops/README.md for why).
#
# CTF-3 "Secrets and misconfiguration": the plan's ladder rows 5, 8, 11
# (leaky-config, git-secrets, tfstate-treasure) -- leaked credentials and
# their reach. Row 11 has no image: compose/ seeds each student's infra-state
# repo and the OpenBao AppRole (needs `openbao` in MODULES).
WORKSHOP_NAME="CTF-3: Secrets and Misconfiguration"
WORKSHOP_DESCRIPTION="Capture-the-flag: leaked credentials and how far they reach"
WORKSHOP_ORDER=102   # position in the learning path (0 = showcase); ./dojo list sorts by it
WORKSHOP_DURATION="~115 min"   # plan section 8
WORKSHOP_CONTENT_DIR=../workshops/ctf-secrets-config/content
FORGEJO_ORG=training
FORGEJO_REPO=ctf-secrets-config     # content/sample-repo/ (briefing notes only) seeded as training/ctf-secrets-config

# Modules this workshop uses (./dojo modules lists them).
MODULES="ctf-range openbao"

# Small on purpose for a facilitator's own live validation run; bump for a
# real class (STUDENT_COUNT drives the slot fan-out, CTF-S1).
STUDENT_COUNT=2

# --- ctf-range control-plane tokens (module.env: empty = fails closed) -----
# Dev-only values. A real class run sets these to something generated, not
# committed; CLAUDE.md: no extra hardening needed for an ephemeral lab, but
# don't commit a value you'd mind a student reading.
CTF_CONTROL_TOKEN=dev-ctf-control-token-ctf-secrets-config

# --- CTF-D26 per-pack ctf-host image scoping ---------------------------
# Build only CTF-3's own target rootfses into ctf-host, not the full
# 14-target catalog (module.env's default). See ctf-host/Dockerfile's
# `ctf-host-ctf3` stage and CTF-SPIKES.md's CTF-D26.
CTF_HOST_BUILD_TARGET=ctf-host-ctf3
CTF_HOST_IMAGE=gitopsdojo/ctf-host:ctf3
CTF_HOST_EXPECTED_IMAGES="ctf-leaky-config:base ctf-git-secrets:base"

# CTF-3's container targets (plan section 8's row order: 5, 8). Ids match each target's own directory name under
# modules/ctf-range/targets/; module.env's own default stays empty for every
# other pack. tfstate-treasure (row 11) has no image, so it is not listed
# here; its hooks live in compose/.
CTF_ATTACK_TARGETS=leaky-config=ctf-leaky-config:base,git-secrets=ctf-git-secrets:base

# A Compose overlay for extra services, only if no module provides them:
# COMPOSE_OVERLAY=../workshops/ctf-secrets-config/compose/docker-compose.override.yml
COMPOSE_OVERLAY=../workshops/ctf-secrets-config/compose/docker-compose.override.yml
