# Workshop identity for ctf-server-trust (CTF-2, docs/CTF-WORKSHOP-PLAN.md), read by
# ./run.sh (made by `./run.sh new-workshop`, then wired to the real attack
# ladder). Paths are relative to engine/ (the compose base file's directory,
# see workshops/README.md for why).
#
# CTF-2 "Server-side trust and APIs": the plan's ladder rows 4, 7, 12, 13
# (ping-tool, ssrf-fetcher, api-mass-assignment, api-bfla) -- the
# medium/hard tier, no module deps beyond ctf-range itself. Students only
# ever attack these four, never patch them (that's CTF-5); there is no seed
# repo for the targets themselves.
WORKSHOP_NAME="CTF-2: Server-side Trust and APIs"
WORKSHOP_DESCRIPTION="Capture-the-flag: when the server trusts input or the caller a little too much"
WORKSHOP_ORDER=101   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_DURATION="~150 min"   # plan section 8
WORKSHOP_CONTENT_DIR=../workshops/ctf-server-trust/content
FORGEJO_ORG=training
FORGEJO_REPO=ctf-server-trust     # content/sample-repo/ (briefing notes only; no lab writes here) seeded as training/ctf-server-trust

# Modules this workshop uses (./run.sh modules lists them).
MODULES="ctf-range"

# Small on purpose for a facilitator's own live validation run; bump for a
# real class (STUDENT_COUNT drives the slot fan-out, CTF-S1).
STUDENT_COUNT=2

# --- ctf-range control-plane tokens (module.env: empty = fails closed) -----
# Dev-only values. A real class run sets these to something generated, not
# committed; CLAUDE.md: no extra hardening needed for an ephemeral lab, but
# don't commit a value you'd mind a student reading.
CTF_CONTROL_TOKEN=dev-ctf-control-token-ctf-server-trust

# --- CTF-D26 per-pack ctf-host image scoping ---------------------------
# Build only CTF-2's own 4 target rootfses into ctf-host, not the full
# 14-target catalog (module.env's default). See ctf-host/Dockerfile's
# `ctf-host-ctf2` stage and CTF-SPIKES.md's CTF-D26.
CTF_HOST_BUILD_TARGET=ctf-host-ctf2
CTF_HOST_IMAGE=gitopsdojo/ctf-host:ctf2
CTF_HOST_EXPECTED_IMAGES="ctf-ping-tool:base ctf-ssrf-fetcher:base ctf-api-mass-assignment:base ctf-api-bfla:base"

# CTF-2's own 4-target slice of the ladder (plan section 8's row order:
# 4, 7, 12, 13). Ids match each target's own directory name under
# modules/ctf-range/targets/; module.env's own default stays empty for every
# other pack.
CTF_ATTACK_TARGETS=ping-tool=ctf-ping-tool:base,ssrf-fetcher=ctf-ssrf-fetcher:base,api-mass-assignment=ctf-api-mass-assignment:base,api-bfla=ctf-api-bfla:base

# A Compose overlay for extra services, only if no module provides them:
# COMPOSE_OVERLAY=../workshops/ctf-server-trust/compose/docker-compose.override.yml
COMPOSE_OVERLAY=
