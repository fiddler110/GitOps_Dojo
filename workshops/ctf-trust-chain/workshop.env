# Workshop identity for ctf-trust-chain (CTF-4, docs/CTF-WORKSHOP-PLAN.md), read by
# ./dojo (made by `./dojo new-workshop`, then wired to the real attack
# ladder). Paths are relative to engine/ (the compose base file's directory,
# see workshops/README.md for why).
#
# CTF-4 "Trusting the wrong thing": the plan's ladder rows 6, 9 (dns-resolver-cve,
# policy-bypass) -- Medium/Hard tier, no module deps beyond ctf-range itself.
# Students only ever attack these targets, never patch them (that's CTF-5);
# there is no seed repo for the targets themselves. A third target for this
# session, 10 `runner-escape`, has no image yet and needs `runner-pool` in
# MODULES -- see README.md/FACILITATOR.md for the plan to add it later.
WORKSHOP_NAME="CTF-4: Trusting the Wrong Thing"
WORKSHOP_DESCRIPTION="Capture-the-flag: a component, a rule, or a pipeline you trusted that you shouldn't have"
WORKSHOP_ORDER=103   # position in the learning path (0 = showcase); ./dojo list sorts by it
WORKSHOP_DURATION="~115 min (plan section 8)"
WORKSHOP_CONTENT_DIR=../workshops/ctf-trust-chain/content
FORGEJO_ORG=training
FORGEJO_REPO=ctf-trust-chain     # content/sample-repo/ (briefing notes only; no lab writes here) seeded as training/ctf-trust-chain

# Modules this workshop uses (./dojo modules lists them).
MODULES="ctf-range"

# Small on purpose for a facilitator's own live validation run; bump for a
# real class (STUDENT_COUNT drives the slot fan-out, CTF-S1).
STUDENT_COUNT=2

# --- ctf-range control-plane tokens (module.env: empty = fails closed) -----
# Dev-only values. A real class run sets these to something generated, not
# committed; CLAUDE.md: no extra hardening needed for an ephemeral lab, but
# don't commit a value you'd mind a student reading.
CTF_CONTROL_TOKEN=dev-ctf-control-token-ctf-trust-chain

# --- CTF-D26 per-pack ctf-host image scoping ---------------------------
# Build only CTF-4's own 2 target rootfses into ctf-host, not the full
# 14-target catalog (module.env's default). See ctf-host/Dockerfile's
# `ctf-host-ctf4` stage and CTF-SPIKES.md's CTF-D26.
CTF_HOST_BUILD_TARGET=ctf-host-ctf4
CTF_HOST_IMAGE=gitopsdojo/ctf-host:ctf4
CTF_HOST_EXPECTED_IMAGES="ctf-dns-resolver-cve:base ctf-policy-bypass:base"

# CTF-4's own 2-target slice of the ladder (plan section 8's row order: 6, 9).
# Ids match each target's own directory name under modules/ctf-range/targets/;
# module.env's own default stays empty for every other pack.
CTF_ATTACK_TARGETS=dns-resolver-cve=ctf-dns-resolver-cve:base,policy-bypass=ctf-policy-bypass:base

# A Compose overlay for extra services, only if no module provides them:
# COMPOSE_OVERLAY=../workshops/ctf-trust-chain/compose/docker-compose.override.yml
COMPOSE_OVERLAY=
