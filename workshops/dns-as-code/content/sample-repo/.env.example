# Copy this file to .env (or run `python3 scripts/dnsctl.py setup`, which
# does this for you). Never commit .env.
#
# This lab's PowerDNS provider doesn't use this value at all - its
# credential is the static apiKey already in creds.json. CLOUDFLARE_API_TOKEN
# is only here because dnsctl.py's doctor/preview/push/begin commands are
# the real production script and hard-check for this exact variable name
# before running dnscontrol, regardless of which provider dnsconfig.js
# actually points at. Any non-empty value satisfies that check - see the
# slides for why this is left as-is instead of patched out.
CLOUDFLARE_API_TOKEN=lab-placeholder-not-a-real-token

# Only needed for submit/status/review/merge/validate against a Forgejo
# remote (this lab's git-server) - a Forgejo access token, so dnsctl_lib/
# forgejo.py doesn't have to prompt you for your Forgejo password on every
# command. Optional: leave unset and it'll prompt once per terminal session
# and cache the result instead (see forgejo.py's _auth_header()).
# FORGEJO_TOKEN=your-forgejo-access-token-here
