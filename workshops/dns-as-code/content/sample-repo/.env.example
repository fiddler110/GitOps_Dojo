# Optional per-person settings for scripts/dnsctl.py. `python3 scripts/dnsctl.py
# setup` copies this file to .env, which is git-ignored (and the pre-commit
# hook refuses to commit it). Nothing here is required: dnscontrol reads the
# PowerDNS API URL and key from creds.json, and dnsctl's Forgejo commands
# (submit/status/review/approve/merge/validate) reuse your git login.

# A Forgejo access token (Settings > Applications in Forgejo). If set, dnsctl
# uses it for the Forgejo API instead of asking git for your username and
# password.
# FORGEJO_TOKEN=your-forgejo-access-token-here
