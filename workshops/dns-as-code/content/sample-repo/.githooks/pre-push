#!/usr/bin/env bash
# Local early warning to go with Forgejo's branch protection: refuses to
# push to main from this machine unless "dnscontrol preview" passes. (Forgejo
# itself rejects direct pushes to main anyway; this catches a broken
# dnsconfig.js before it even leaves your terminal.)
#
# Enable once per clone with `python3 scripts/dnsctl.py setup`, which runs:
#   git config core.hooksPath .githooks

set -euo pipefail

protected_ref="refs/heads/main"
zero="0000000000000000000000000000000000000000"

# Keep this file list identical to the `paths:` filter in
# .forgejo/workflows/dns-apply.yml — if they drift, this local check and CI
# stop agreeing about what's DNS-relevant.
dns_relevant_paths=(dnsconfig.js creds.json)

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_ref" ]; then
    if [ "$local_sha" = "$zero" ]; then
      # Deleting the ref (git push --delete) — nothing to preview.
      continue
    fi

    if [ "$remote_sha" = "$zero" ]; then
      range="$local_sha"            # new branch: check every commit being introduced
    else
      range="${remote_sha}..${local_sha}"
    fi

    if ! git diff --name-only "$range" -- "${dns_relevant_paths[@]}" | grep -q .; then
      echo "pre-push: no changes to ${dns_relevant_paths[*]} — skipping preview."
      continue
    fi

    echo "pre-push: verifying dnscontrol preview before pushing to main..."

    if [ -f .env ]; then
      set -a
      # shellcheck disable=SC1091
      source .env
      set +a
    fi

    if ! command -v dnscontrol >/dev/null 2>&1; then
      echo "pre-push: dnscontrol not found in PATH — install it before pushing to main." >&2
      exit 1
    fi

    if ! dnscontrol preview; then
      echo "pre-push: dnscontrol preview failed — push to main blocked." >&2
      exit 1
    fi

    echo "pre-push: preview OK, proceeding with push to main."
  fi
done

exit 0
