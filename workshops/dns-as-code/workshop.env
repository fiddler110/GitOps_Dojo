# Workshop identity for dns-as-code, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="DNS as Code Lab"
WORKSHOP_DESCRIPTION="Manage DNS records as code: change a zone in Git and watch a pipeline apply it."
WORKSHOP_ORDER=2   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_CONTENT_DIR=../workshops/dns-as-code/content
FORGEJO_ORG=dns-team
FORGEJO_REPO=dns-as-code

# Adds a dns-server (PowerDNS) service and swaps in a terminal image with
# dnscontrol + dig preinstalled. See workshops/dns-as-code/compose/.
COMPOSE_OVERLAY=../workshops/dns-as-code/compose/docker-compose.override.yml

# Reusable parts from the top-level modules/ folder (see modules/<name>/README.md).
# runner-pool: Forgejo Actions with single-use runners (job tool: dnscontrol),
#   so the sample repo's workflows run and no job sees another's files.
# dns-ui: the read-only DNS Zones page (/dns), so students can see what PowerDNS serves.
# dns-gate: dns-api, the only way to the PowerDNS API: each account changes
#   only its own <user>.dojo.test, and dojo.test only from CI (below).
MODULES="runner-pool dns-ui dns-gate sensei"

# dns-gate: dojo.test changes only with a Forgejo Actions ID token from a push
# to main of the class repo (the DNS Apply job, after a reviewed merge).
DNS_GATE_USER_PARENTS=dojo.test
DNS_GATE_CI_ZONES=dojo.test
DNS_GATE_CI_REPO="${FORGEJO_ORG}/${FORGEJO_REPO}"

# The key PowerDNS itself accepts. Derived from this install's GATEWAY_TOKEN
# (engine/.env, sourced first), so it is never in the repo and students never
# see it: they hold their own key ($DNS_API_KEY) and CI its job's ID token,
# which only the dns-api gate accepts. The dns-ui module reads
# POWERDNS_API_KEY too, so it talks to PowerDNS directly with this one.
POWERDNS_API_KEY="$(printf 'dns-as-code/powerdns:%s' "${GATEWAY_TOKEN:?}" | sha256sum | cut -c1-40)"

# Reviews a PR to main needs before it can merge (compose/gates/protect-main.sh).
DNS_REQUIRED_APPROVALS=1

# Sensei (modules/sensei) opens one PR into the class repo so every student has something to
# review in Lab 3 (achievement d3-review). It never approves or merges it. There is no roster
# in this workshop, so SENSEI_REPO is left unset and Sensei only seeds.
SENSEI_SEED='{"repo":"dns-team/dns-as-code","file":"dnsconfig.js","before":"\tA(\"mail\", \"203.0.113.20\"),","line":"\tA(\"status\", \"203.0.113.30\"),","branch":"dns-bot/add-status","title":"Add status.dojo.test (from Sensei, review me)","body":"Practice pull request from Sensei: read the diff and the DNS Preview comment, then approve it if you are happy. Merging is up to the facilitator."}'
