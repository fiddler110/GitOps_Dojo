# Workshop identity for dns-as-code, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="DNS as Code Lab"
WORKSHOP_CONTENT_DIR=../workshops/dns-as-code/content
FORGEJO_ORG=dns-team
FORGEJO_REPO=dns-as-code

# Adds a dns-server (PowerDNS) service and swaps in a terminal image with
# dnscontrol + dig preinstalled. See workshops/dns-as-code/compose/.
COMPOSE_OVERLAY=../workshops/dns-as-code/compose/docker-compose.override.yml

# Reusable parts from the top-level modules/ folder (see modules/<name>/README.md).
# forgejo-runner: Forgejo Actions + a runner, so the sample repo's workflows run.
# dns-ui: the read-only DNS Zones page (/dns), so students can see what PowerDNS serves.
MODULES="forgejo-runner dns-ui"

# The key PowerDNS itself accepts. Derived from this install's GATEWAY_TOKEN
# (engine/.env, sourced first), so it is never in the repo and students never
# see it: they and CI use the public key in creds.json, which only the dns-api
# gate accepts (compose/docker-compose.override.yml). The dns-ui module reads
# POWERDNS_API_KEY too, so it talks to PowerDNS directly with this one.
POWERDNS_API_KEY="$(printf 'dns-as-code/powerdns:%s' "${GATEWAY_TOKEN:?}" | sha256sum | cut -c1-40)"

# Reviews a PR to main needs before it can merge (compose/gates/protect-main.sh).
DNS_REQUIRED_APPROVALS=1
