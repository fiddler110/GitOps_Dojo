# Workshop identity for dns-as-code, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="DNS as Code Lab"
WORKSHOP_CONTENT_DIR=../workshops/dns-as-code/content
FORGEJO_ORG=dns-team
FORGEJO_REPO=dns-as-code

# Adds a dns-server (PowerDNS) service and swaps in a terminal image with
# dnscontrol + dig preinstalled. See workshops/dns-as-code/compose/.
COMPOSE_OVERLAY=../workshops/dns-as-code/compose/docker-compose.override.yml

# Reusable parts from the top-level modules/ folder (see modules/<name>/README.md).
# forgejo-runner: Forgejo Actions + a runner, so the sample repo's workflows run.
MODULES="forgejo-runner"
