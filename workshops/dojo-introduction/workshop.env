# Workshop identity for dojo-introduction, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
#
# The showcase: every capability of the platform up at once, for a facilitator
# to click through as a student and as the facilitator. No lab is meant to be
# worked here; the four workshops' slides and labs are on the hub instead.
WORKSHOP_NAME="Dojo Introduction"
WORKSHOP_CONTENT_DIR=../workshops/dojo-introduction/content
FORGEJO_ORG=dojo-team
FORGEJO_REPO=dojo-tour

# Forgejo + Actions, the vault, single-use CI runners, Dojo Cloud, the DNS
# Zones page and dns-api (dns-gate). forgejo-runner is not listed: it cannot
# run beside runner-pool.
MODULES="openbao runner-pool dojo-cloud dns-ui dns-gate"

# dns-gate: each account's own key ($DNS_API_KEY) changes its own
# <user>.dojo.test zone and its own names in certs.dojo.test. dojo.test is a
# CI-only zone with no CI repo, so nobody changes it here.
DNS_GATE_USER_PARENTS="dojo.test certs.dojo.test"
DNS_GATE_SHARED_ZONES=certs.dojo.test
DNS_GATE_CI_ZONES=dojo.test
DNS_GATE_CI_REPO=

# PowerDNS, step-ca and the cert demo site, the vault's namespaces, and the
# hub's view of the other workshops' slides. See compose/.
COMPOSE_OVERLAY=../workshops/dojo-introduction/compose/docker-compose.override.yml

# The key PowerDNS itself accepts, derived from this install's GATEWAY_TOKEN
# (engine/.env, sourced first) as dns-as-code does, so it is not in the repo
# and students never see it. The dns-ui module reads it too.
POWERDNS_API_KEY="$(printf 'dojo-introduction/powerdns:%s' "${GATEWAY_TOKEN:?}" | sha256sum | cut -c1-40)"
