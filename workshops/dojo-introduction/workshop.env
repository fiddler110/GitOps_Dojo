# Workshop identity for dojo-introduction, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
#
# The showcase: Forgejo with CI, DNS as code and Dojo Cloud up at once, for a
# facilitator to click through as a student and as the facilitator. No lab is
# meant to be worked here; every workshop's slides and labs are on the hub.
WORKSHOP_NAME="Dojo Introduction"
WORKSHOP_DESCRIPTION="A guided tour of the dojo: the slides, editor, terminal and Git server you'll use."
WORKSHOP_ORDER=0   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_DURATION="~35 min"   # how long a session takes, shown by ./run.sh list; keep it in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/dojo-introduction/content
FORGEJO_ORG=dojo-team
FORGEJO_REPO=dojo-tour

# Forgejo Actions on single-use CI runners, Dojo Cloud, the DNS Zones page and
# dns-api (dns-gate). The vault and the certificate lab are left out to keep
# the tour light: run vault-fundamentals or cert-autorenewal to show them.
MODULES="runner-pool dojo-cloud dns-ui dns-gate sensei"

# dns-gate: each account's own key ($DNS_API_KEY) changes its own
# <user>.dojo.test zone. dojo.test is a CI-only zone with no CI repo, so
# nobody changes it here.
DNS_GATE_USER_PARENTS=dojo.test
DNS_GATE_CI_ZONES=dojo.test
DNS_GATE_CI_REPO=

# PowerDNS and the hub's view of the other workshops' slides. See compose/.
COMPOSE_OVERLAY=../workshops/dojo-introduction/compose/docker-compose.override.yml

# The key PowerDNS itself accepts, derived from this install's GATEWAY_TOKEN
# (.env, sourced first) as dns-as-code does, so it is not in the repo
# and students never see it. The dns-ui module reads it too.
POWERDNS_API_KEY="$(printf 'dojo-introduction/powerdns:%s' "${GATEWAY_TOKEN:?}" | sha256sum | cut -c1-40)"
