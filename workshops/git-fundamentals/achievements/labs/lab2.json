{
  "milestones": [
    {
      "id": "l2-restore",
      "title": "The Undo Button",
      "joke": "Ctrl+Z, but it's git.",
      "core": true,
      "when": "shell: `git restore <file>` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "git restore",
        "flags_none": [
          "--staged",
          "-S"
        ],
        "exit": 0
      }
    },
    {
      "id": "l2-unstage",
      "title": "Never Mind",
      "joke": "Staged it, regretted it, unstaged it. Growth.",
      "core": true,
      "when": "shell: `git restore --staged` or `git reset` (exit 0)",
      "match": {
        "any": [
          {
            "source": "shell",
            "cmd": "git restore",
            "flags": [
              "--staged",
              "-S"
            ],
            "exit": 0
          },
          {
            "source": "shell",
            "cmd": "git reset",
            "flags_none": [
              "--hard",
              "--soft",
              "--keep",
              "--merge"
            ],
            "exit": 0
          }
        ]
      }
    },
    {
      "id": "l2-ignore",
      "title": "Ignorance Is Bliss",
      "joke": "Some files are better left unseen.",
      "core": true,
      "when": "shell: a command that writes `.gitignore`",
      "match": {
        "any": [
          {
            "source": "shell",
            "regex": "(>>?|\\btee( -a)?) (\\S*/)?\\.gitignore\\b",
            "exit": 0
          },
          {
            "source": "shell",
            "cmd": "git add",
            "regex": "(^| )(\\S*/)?\\.gitignore\\b",
            "exit": 0
          }
        ]
      }
    }
  ]
}
