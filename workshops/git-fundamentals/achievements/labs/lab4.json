{
  "milestones": [
    {
      "id": "l4-log",
      "title": "Historian",
      "joke": "Reading the group chat of the repo.",
      "core": true,
      "when": "shell: `git log` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "git log",
        "exit": 0
      }
    },
    {
      "id": "l4-show",
      "title": "Crime Scene Investigator",
      "joke": "One commit, every detail.",
      "core": true,
      "when": "shell: `git show` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "git show",
        "exit": 0
      }
    },
    {
      "id": "l4-blame",
      "title": "The Blame Game",
      "joke": "Someone wrote this line. Now you know who.",
      "core": true,
      "when": "shell: `git blame` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "git blame",
        "exit": 0
      }
    },
    {
      "id": "l4-compare",
      "title": "Spot the Difference",
      "joke": "Two branches walk into a diff.",
      "core": true,
      "when": "shell: `git diff <a>..<b>` or `git log <a>..<b>`",
      "match": {
        "source": "shell",
        "cmd": [
          "git diff",
          "git log"
        ],
        "regex": "\\S\\.\\.\\.?\\S",
        "exit": 0
      }
    }
  ]
}
