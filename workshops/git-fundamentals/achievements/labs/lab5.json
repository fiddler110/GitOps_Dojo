{
  "milestones": [
    {
      "id": "l5-conflict",
      "title": "Conflict Zone",
      "joke": "Two edits, one line, zero chill.",
      "core": true,
      "when": "shell: `git merge` exits non-zero and leaves a conflict",
      "match": {
        "source": "shell",
        "cmd": "git merge",
        "exit": "nonzero",
        "merging_after": true
      }
    },
    {
      "id": "l5-resolved",
      "title": "The Peacemaker",
      "joke": "You picked a side. Or both. Diplomat.",
      "core": true,
      "when": "shell: `git commit` completes a merge (conflict resolved)",
      "match": {
        "any": [
          {
            "source": "shell",
            "cmd": "git commit",
            "exit": 0,
            "merging": true,
            "merging_after": false
          },
          {
            "source": "shell",
            "cmd": "git merge",
            "flags": [
              "--continue"
            ],
            "exit": 0,
            "merging": true
          }
        ]
      }
    },
    {
      "id": "l5-revert",
      "title": "Time Traveller",
      "joke": "Undid a commit the polite way.",
      "core": true,
      "when": "shell: `git revert` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "git revert",
        "flags_none": [
          "--abort",
          "--quit"
        ],
        "exit": 0
      }
    },
    {
      "id": "l5-reset",
      "title": "Nuclear Option",
      "joke": "Used reset. Hopefully on purpose.",
      "core": true,
      "when": "shell: `git reset --hard` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "git reset",
        "flags": [
          "--hard"
        ],
        "exit": 0
      }
    }
  ]
}
