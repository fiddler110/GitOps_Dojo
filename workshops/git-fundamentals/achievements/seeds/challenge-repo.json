{
  "builder": "forgejo-repo",
  "repo": "{user}/challenge-repo",
  "description": "{user}'s own challenge repo (Git Fundamentals)",
  "private": false,
  "linked": [["role", "role_typo"]],
  "values": {
    "role": ["Software Engineer", "Site Reliability Engineer", "Platform Engineer", "Release Manager",
             "Security Analyst", "Database Administrator", "Network Engineer", "Technical Writer"],
    "role_typo": ["Sofware Enginer", "Site Reliablity Engineer", "Platfrom Engineer", "Release Manger",
                  "Secuirty Analyst", "Databse Administrator", "Netwrok Engineer", "Techincal Writer"],
    "target_line": ["deploy_on_friday: true", "coffee_budget: unlimited", "code_review: optional",
                    "tests_required: false", "pager_owner: nobody", "meetings_per_day: 11",
                    "logging_level: whisper", "backup_schedule: never"],
    "culprit": ["Mallory Mischief", "Trent Tinkerton", "Eve Sneakwell", "Oscar Override", "Peggy Patchwork",
                "Victor Vandal", "Sybil Shortcut", "Chuck Cowboy"],
    "feature_a": ["Dark mode for the dashboard", "Search box on the roster page", "CSV export of the roster",
                  "Keyboard shortcuts for reviewers", "Weekly digest email", "Team birthdays calendar",
                  "Status page for deploys", "Standup notes page"],
    "feature_b": ["Alerts go to the on-call phone", "Retry button on failed deploys", "Audit log for settings changes",
                  "Two-step login for admins", "Faster roster loading", "Deploy freeze on holidays",
                  "Owner field on every setting", "Health check before each deploy"]
  },
  "commits": [
    {"author": "Alice Engineer", "days_ago": 30, "message": "Start the team repo",
     "files": [{"path": "README.md", "from": "challenge-repo/README.md"},
               {"path": "roster/team.yaml", "from": "challenge-repo/roster/team.yaml"}]},
    {"author": "Bob Operator", "days_ago": 25, "message": "Add team settings",
     "files": [{"path": "config/settings.yaml", "from": "challenge-repo/config/settings.yaml"}]},
    {"author": "Alice Engineer", "days_ago": 20, "message": "Retry flaky deploys three times",
     "files": [{"path": "config/settings.yaml", "append": "retries: 3"}]},
    {"author": "{culprit}", "days_ago": 14, "message": "Tidy up settings",
     "files": [{"path": "config/settings.yaml", "append": "{target_line}"}]},
    {"author": "Bob Operator", "days_ago": 9, "message": "Give deploys more time",
     "files": [{"path": "config/settings.yaml", "append": "timeout_seconds: 30"}]},
    {"author": "Bob Operator", "days_ago": 5, "message": "Add Carol to the roster",
     "files": [{"path": "roster/team.yaml", "append": "- name: Carol Tester\n  role: Quality Assurance"}]},
    {"author": "Bob Operator", "days_ago": 3, "message": "Start a changelog",
     "files": [{"path": "CHANGELOG.md", "append": "# Changelog\n\n## Next release\n"}]},
    {"author": "Alice Engineer", "days_ago": 2, "message": "Name an owner for the settings",
     "files": [{"path": "config/settings.yaml", "append": "owner: alice.engineer"}]},
    {"branch": "feature-a", "from": "main", "author": "Alice Engineer", "days_ago": 1,
     "message": "Changelog: {feature_a}",
     "files": [{"path": "CHANGELOG.md", "append": "- {feature_a}"}]},
    {"branch": "feature-b", "from": "main", "author": "Bob Operator", "days_ago": 1,
     "message": "Changelog: {feature_b}",
     "files": [{"path": "CHANGELOG.md", "append": "- {feature_b}"}]},
    {"branch": "feature-b", "author": "{culprit}", "days_ago": 1, "message": "Make deploys faster",
     "files": [{"path": "config/settings.yaml", "replace": ["timeout_seconds: 30", "timeout_seconds: 0"]}]}
  ]
}
