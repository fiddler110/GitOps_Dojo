#!/usr/bin/env bash
# lab-history: build ~/lab/history-repo, a small local repo with a story in its
# history (two authors, two feature branches that fork at different points and merge in the opposite order, a secret committed and then
# removed, a revert), so Lab 4 has something worth investigating. Nothing is
# pushed; the repo only exists in this student's terminal. Safe to run twice:
# if the repo is already there it is left alone.
#   lab-history           build it (no-op if it exists)
#   lab-history --reset   delete it and build it again
set -euo pipefail

REPO=$HOME/lab/history-repo

if [ "${1:-}" = "--reset" ]; then rm -rf "$REPO"; fi
if [ -d "$REPO/.git" ]; then
  echo "    already done: $REPO exists (lab-history --reset rebuilds it)"
  exit 0
fi

mkdir -p "$REPO"
cd "$REPO"
git init -q -b main

# commit <who> <when> <message>: stage everything and commit with fixed dates,
# so every student's history reads the same.
commit() {
  local who=$1 when=$2 msg=$3 name email
  case $who in
    alice) name="Alice Engineer"; email=alice@example.com ;;
    bob)   name="Bob Operator";   email=bob@example.com ;;
  esac
  git add -A
  GIT_AUTHOR_NAME=$name GIT_AUTHOR_EMAIL=$email GIT_AUTHOR_DATE="$when" \
  GIT_COMMITTER_NAME=$name GIT_COMMITTER_EMAIL=$email GIT_COMMITTER_DATE="$when" \
    git commit -q -m "$msg"
}
merge() {
  local when=$1; shift
  GIT_AUTHOR_NAME="Alice Engineer" GIT_AUTHOR_EMAIL=alice@example.com GIT_AUTHOR_DATE="$when" \
  GIT_COMMITTER_NAME="Alice Engineer" GIT_COMMITTER_EMAIL=alice@example.com GIT_COMMITTER_DATE="$when" \
    git merge -q --no-ff "$@"
}

printf '# shop-config\n\nSettings and deploy script for the web shop.\n' > README.md
commit alice "2026-08-03T09:00:00" "Initial commit"

mkdir config
printf 'app:\n  name: webshop\n  port: 8080\n  timeout: 30\n' > config/app.yaml
commit alice "2026-08-03T10:15:00" "Add app config"

printf 'database:\n  host: db.internal\n  port: 5432\n  name: shop\n' >> config/app.yaml
commit bob "2026-08-04T14:20:00" "Add database settings"

# Alice starts her logging branch here, early, and finishes it last.
git checkout -q -b feature/logging
printf 'logging:\n  level: info\n  file: /var/log/webshop.log\n' > config/logging.yaml
commit alice "2026-08-05T09:10:00" "Add logging settings"
git checkout -q main

# The mistake: a credential pasted in "just to test".
printf 'azure:\n  client_secret: Dkx8Q~vT3nR1yWzUe5LqXo7bJ2hGcPaS9mKdF4iN\n' >> config/app.yaml
commit bob "2026-08-05T11:02:00" "Add Azure client secret so I can test the deploy"

printf '#!/usr/bin/env bash\nset -e\necho "Deploying webshop..."\n' > deploy.sh
chmod +x deploy.sh
commit alice "2026-08-05T15:40:00" "Add deploy script"

# The cleanup: gone from the file, but not from history.
sed -i '/^azure:/,$d' config/app.yaml
printf 'azure:\n  client_secret_env: AZURE_CLIENT_SECRET\n' >> config/app.yaml
commit bob "2026-08-06T09:30:00" "Remove client secret from config, read it from the environment"

# Bob's health-check branch forks later than Alice's, but is merged first.
git checkout -q -b feature/healthcheck
printf 'curl -fs http://localhost:8080/health\n' >> deploy.sh
commit bob "2026-08-07T10:20:00" "Check the health endpoint after deploying"
printf 'echo "Deploy OK"\n' >> deploy.sh
commit bob "2026-08-07T16:00:00" "Print a success message once the health check passes"
git checkout -q main

sed -i 's/timeout: 30/timeout: 5/' config/app.yaml
commit bob "2026-08-07T13:10:00" "Lower request timeout to 5 seconds"
printf '\n## Deploying\n\nRun ./deploy.sh from the repo root.\n' >> README.md
commit bob "2026-08-08T09:45:00" "Document the deploy script"

merge "2026-08-08T15:00:00" feature/healthcheck -m "Merge branch 'feature/healthcheck'"

git checkout -q feature/logging
sed -i 's/level: info/level: debug/' config/logging.yaml
commit alice "2026-08-09T11:25:00" "Turn logging up to debug while testing"
git checkout -q main
merge "2026-08-10T10:00:00" feature/logging -m "Merge branch 'feature/logging'"

sed -i 's/timeout: 5/timeout: 30/' config/app.yaml
commit alice "2026-08-10T14:30:00" "Revert timeout to 30 seconds: 5 broke slow checkouts"

git branch -q -d feature/logging feature/healthcheck
echo "    built $REPO ($(git rev-list --count HEAD) commits on main)"
