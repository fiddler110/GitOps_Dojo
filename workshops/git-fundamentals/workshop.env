# Workshop identity for git-fundamentals, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="Git Training Lab"
WORKSHOP_ORDER=1   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_CONTENT_DIR=../workshops/git-fundamentals/content
FORGEJO_ORG=training
FORGEJO_REPO=sample-training-repo

# No overlay — this workshop uses the engine's default services
# (web-terminal as-is, no extra backend).
COMPOSE_OVERLAY=
