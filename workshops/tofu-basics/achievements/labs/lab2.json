{
  "milestones": [
    {
      "id": "t2-idem",
      "title": "Idempotent, Baby",
      "joke": "Applied twice, changed once.",
      "core": true,
      "when": "shell: second `tofu apply` reports 0 changes",
      "match": {}
    },
    {
      "id": "t2-change",
      "title": "Tilde Time",
      "joke": "An in-place change, read carefully.",
      "core": true,
      "when": "shell: `tofu plan` shows `~`",
      "match": {}
    },
    {
      "id": "t2-replace",
      "title": "Out With the Old",
      "joke": "Forced a replacement.",
      "core": true,
      "when": "shell: `tofu apply -replace=...` or plan `-/+`",
      "match": {}
    },
    {
      "id": "t2-broke",
      "title": "Broke It On Purpose",
      "joke": "Errors are teachers.",
      "core": true,
      "when": "shell: `tofu validate` or `plan` exits 1",
      "match": {}
    }
  ]
}
