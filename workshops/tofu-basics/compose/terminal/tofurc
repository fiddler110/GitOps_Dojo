# System-wide OpenTofu CLI config (root-owned; students cannot edit it).
# The lab network has no internet, so providers come only from the mirror
# baked into the image at /opt/tofu-providers.
provider_installation {
  filesystem_mirror {
    path    = "/opt/tofu-providers"
    include = ["registry.opentofu.org/*/*"]
  }
  direct {
    exclude = ["registry.opentofu.org/*/*"]
  }
}
