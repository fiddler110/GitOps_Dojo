#!/usr/bin/env bash
# A fake container CLI for tests/selftest (podman/docker look-alike). It understands only what lib.sh, e2e.sh and load.sh
# call, runs "student" commands locally in a scratch directory with a fake terraform/git/curl on PATH, and forwards the
# helper scripts meant for cloud-api to a local mock of the portal API. Nothing here proves anything about the real stack.
set -u
: "${MOCK_ROOT:?MOCK_ROOT must point at the selftest scratch directory}"
HERE=$(cd "$(dirname "$0")" && pwd)
LOG=$MOCK_ROOT/cli.log
printf '%s\n' "$*" | cut -c1-200 >> "$LOG"
verb=${1:-}; shift || true
case $verb in
  inspect)
    fmt=""; while [ $# -gt 1 ]; do case $1 in -f) fmt=$2; shift 2 ;; *) shift ;; esac; done
    case $fmt in
      *State.Running*) echo true ;;
      *HostConfig.Memory*) echo "${MOCK_TERMINAL_MEM:-4294967296}" ;;
      *OOMKilled*) echo "oomkilled=false restarts=0" ;;
    esac; exit 0 ;;
  stats)
    now=$(date +%s)
    cat <<JSON
[
 {"id":"a","name":"workshop_terminal","cpu_percent":"$((now % 400))%","mem_usage":"$((1000 + now % 900))MB / 4.29GB","mem_percent":"30.00%","pids":"$((now % 90))"},
 {"id":"b","name":"workshop_cloud_api","cpu_percent":"3%","mem_usage":"41.5MB / 268.4MB","mem_percent":"15.00%","pids":"9"},
 {"id":"c","name":"workshop_cloud_host","cpu_percent":"12%","mem_usage":"1.2GB / 3.22GB","mem_percent":"37.00%","pids":"120"}
]
JSON
    exit 0 ;;
  start|restart|stop|cp|rm) exit 0 ;;
  exec) ;;
  *) echo "mock cli: unsupported verb $verb" >&2; exit 64 ;;
esac

# ---- exec ----
user=root; stdin_flag=0
while [ $# -gt 0 ]; do
  case $1 in
    -i) stdin_flag=1; shift ;;
    -u) user=$2; shift 2 ;;
    -w|-e) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
ctr=$1; shift
export CLOUD_HTTP_PORT=${MOCK_PORT:?} GATEWAY_TOKEN=mocktoken FACILITATOR_USERNAME=admin
case ${1:-} in
  printenv)
    case ${2:-} in STUDENT_PREFIX) echo student ;; STUDENT_COUNT) echo "${MOCK_STUDENT_COUNT:-20}" ;; *) exit 1 ;; esac; exit 0 ;;
  id) case ${3:-} in student0[1-9]|student1[0-9]|student20) exit 0 ;; *) exit 1 ;; esac ;;
  sh)
    case "$*" in *oom_kill*) echo "oom_kill 0"; exit 0 ;; *) exit 0 ;; esac ;;
  cat) echo 123456789; exit 0 ;;
  python3) exec python3 "${@:2}" ;;     # `python3 -` reads the script from the stdin we were given; `-c CODE args` works too
  touch|rm|chown) exec "$@" 2>/dev/null ;;
  timeout)
    # timeout -k 5 T zsh -lc CMD   (the student's shell)
    while [ $# -gt 0 ] && [ "$1" != zsh ]; do shift; done
    shift 2                      # zsh -lc
    cmd=$1
    cmd=${cmd//\/home\//$MOCK_ROOT/home/}
    home=$MOCK_ROOT/home/$user; mkdir -p "$home"
    cd "$home" || exit 1
    echo mock-ca > "$MOCK_ROOT/ca.pem"
    export MOCK_USER=$user MOCK_STATE_DIR=$MOCK_ROOT/state HOME=$home
    export ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000 ARM_CLIENT_SECRET=dojo~0123456789abcdef0123456789abcdef01234567 ARM_SUBSCRIPTION_ID=sub SSL_CERT_FILE=$MOCK_ROOT/ca.pem
    export PATH="$HERE:$PATH"
    exec bash -c "$cmd" ;;
esac
echo "mock cli: unsupported exec in $ctr: $*" >&2
exit 64
