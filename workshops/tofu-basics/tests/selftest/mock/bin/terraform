#!/usr/bin/env bash
# fake terraform for tests/selftest: prints the lines the load flow looks for; state is a marker file.
sub=${1:-}; shift || true
user=${MOCK_USER:?}; statef=$MOCK_STATE_DIR/$user
mkdir -p "$MOCK_STATE_DIR"
case $sub in
  version) echo "OpenTofu v1.12.6" ;;
  init)
    echo "Initializing provider plugins..."; echo "- Reusing previous version of hashicorp/azurerm from the dependency lock file"
    echo "OpenTofu has been successfully initialized!" ;;
  apply)
    if [ "${MOCK_FAIL_APPLY_USER:-}" = "$user" ]; then echo "Error: mock apply failure"; echo "1 0" > "$statef"; exit 1; fi
    sleep "0.$((RANDOM % 6 + 3))"
    if [ -f .mock-applied ]; then
      if grep -q cost_center locals.tf; then echo "Apply complete! Resources: 0 added, 2 changed, 0 destroyed."; else echo "No changes."; fi
    else
      touch .mock-applied terraform.tfstate; echo "1 1" > "$statef"
      echo "Apply complete! Resources: 2 added, 0 changed, 0 destroyed."
    fi ;;
  destroy)
    if [ -f .mock-applied ]; then rm -f .mock-applied; echo "0 0" > "$statef"; echo "Destroy complete! Resources: 2 destroyed."
    else echo "Destroy complete! Resources: 0 destroyed."; fi ;;
  *) echo "mock terraform: $sub" ;;
esac
