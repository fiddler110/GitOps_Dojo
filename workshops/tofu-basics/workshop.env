# Workshop identity for tofu-basics, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="OpenTofu Basics Lab"
WORKSHOP_DESCRIPTION="Provision cloud resources with OpenTofu: plan, apply and destroy infrastructure from code."
WORKSHOP_ORDER=4   # position in the learning path (0 = showcase); ./run.sh list sorts by it
WORKSHOP_DURATION="~2¼ h"   # how long a session takes, shown by ./run.sh list; keep it in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/tofu-basics/content
FORGEJO_ORG=iac-team
FORGEJO_REPO=tofu-basics
# Lab 0 has each student fork iac-team/tofu-basics and work in the fork; demo bots
# (--test) do the same. See engine/web-terminal/bot-runner.sh.
FORGEJO_FORK_WORKFLOW=1

# The terminal image with OpenTofu (also runnable as `terraform`) and an
# offline provider mirror is compose/terminal/, picked up by engine/run.sh.
# No compose overlay: Track B's Dojo Cloud is the dojo-cloud module.
MODULES="dojo-cloud sensei"
