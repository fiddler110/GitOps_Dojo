{
  "milestones": [
    {
      "id": "v7-key",
      "title": "Key in the Vault",
      "joke": "A key that never leaves the vault.",
      "core": true,
      "when": "shell: `bao write -f transit/keys/<name>` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "bao write",
        "regex": "transit/keys/[\\w-]+\\s*$",
        "exit": 0
      }
    },
    {
      "id": "v7-encrypt",
      "title": "Encrypted Config",
      "joke": "A file only the key can read.",
      "core": true,
      "when": "shell: `sops encrypt` or `sops -e` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": [
          "sops encrypt",
          "sops -e"
        ],
        "exit": 0
      }
    },
    {
      "id": "v7-rotate",
      "title": "Key Rotation",
      "joke": "A new key version, old data still works.",
      "core": true,
      "when": "shell: `bao write -f transit/keys/<name>/rotate` (exit 0)",
      "match": {
        "source": "shell",
        "cmd": "bao write",
        "regex": "transit/keys/[\\w-]+/rotate\\b",
        "exit": 0
      }
    }
  ]
}
