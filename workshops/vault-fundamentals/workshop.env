# Workshop identity for vault-fundamentals, picked up by engine/run.sh.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="Vault Fundamentals Lab"
WORKSHOP_CONTENT_DIR=../workshops/vault-fundamentals/content
FORGEJO_ORG=platform-team
FORGEJO_REPO=vault-fundamentals

# Adds OpenBao and a terminal image with bao, sops and gitleaks.
# See workshops/vault-fundamentals/compose/ and PLAN.md.
COMPOSE_OVERLAY=../workshops/vault-fundamentals/compose/docker-compose.override.yml
