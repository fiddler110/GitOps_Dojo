# Workshop identity for vault-fundamentals, picked up by dojo.
# Paths are relative to engine/ (the compose base file's directory — see
# workshops/README.md for why).
WORKSHOP_NAME="Vault Fundamentals Lab"
WORKSHOP_DESCRIPTION="Keep secrets out of Git: store, read and rotate them with OpenBao."
WORKSHOP_ORDER=5   # position in the learning path (0 = showcase); ./dojo list sorts by it
WORKSHOP_DURATION="~3½ h"   # how long a session takes, shown by ./dojo list; keep it in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/vault-fundamentals/content
FORGEJO_ORG=platform-team
FORGEJO_REPO=vault-fundamentals
# Lab 8 has each student fork the team repo and work in the fork; demo bots
# (--test, content/bots/steps.sh) do the same. See engine/web-terminal/bot-runner.sh.
FORGEJO_FORK_WORKFLOW=1

# OpenBao, its UI behind the gateway and single sign-on through Forgejo come
# from the openbao module (modules/openbao/). compose/terminal/ adds sops and
# gitleaks on top of the module's bao. CI runs on runner-pool's single-use
# runners (labs 8-9), with the Runners panel in /admin. See VAULT-FUNDAMENTALS-PLAN.md.
MODULES="openbao runner-pool sensei"
# The workshop's OpenBao set-up (namespaces, the student policy, seed
# secrets) runs as hooks in the module's openbao-setup; the overlay mounts them.
COMPOSE_OVERLAY=../workshops/vault-fundamentals/compose/docker-compose.override.yml
